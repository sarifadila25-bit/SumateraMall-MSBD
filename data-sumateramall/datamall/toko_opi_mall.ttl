@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://sumateramall.org/ontology#> .
@prefix res: <http://sumateramall.org/resource/> .

# ============================================
# 5 CLASSES
# ============================================

ex:Mall a rdfs:Class ;
    rdfs:label "Mall"@id ;
    rdfs:comment "Pusat perbelanjaan"@id .

ex:Toko a rdfs:Class ;
    rdfs:label "Toko"@id ;
    rdfs:comment "Toko di dalam mall"@id .

ex:Kategori a rdfs:Class ;
    rdfs:label "Kategori"@id ;
    rdfs:comment "Kategori toko"@id .

ex:Kota a rdfs:Class ;
    rdfs:label "Kota"@id ;
    rdfs:comment "Kota lokasi mall"@id .

ex:Provinsi a rdfs:Class ;
    rdfs:label "Provinsi"@id ;
    rdfs:comment "Provinsi lokasi mall"@id .

# ============================================
# 10 OBJECT PROPERTIES
# ============================================

ex:beradaDiMall a rdf:Property ;
    rdfs:label "beradaDiMall"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range ex:Mall ;
    rdfs:comment "Toko berada di Mall"@id .

ex:beradaDiKota a rdf:Property ;
    rdfs:label "beradaDiKota"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range ex:Kota ;
    rdfs:comment "Mall berada di Kota"@id .

ex:beradaDiProvinsi a rdf:Property ;
    rdfs:label "beradaDiProvinsi"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range ex:Provinsi ;
    rdfs:comment "Mall berada di Provinsi"@id .

ex:memilikiKategori a rdf:Property ;
    rdfs:label "memilikiKategori"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range ex:Kategori ;
    rdfs:comment "Toko memiliki kategori"@id .

ex:beradaDiLantai a rdf:Property ;
    rdfs:label "beradaDiLantai"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range ex:Toko ;
    rdfs:comment "Toko berada di lantai yang sama dengan toko lain"@id .

ex:memilikiToko a rdf:Property ;
    rdfs:label "memilikiToko"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range ex:Toko ;
    rdfs:comment "Mall memiliki toko"@id .

ex:beradaDiKotaYangSama a rdf:Property ;
    rdfs:label "beradaDiKotaYangSama"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range ex:Mall ;
    rdfs:comment "Mall berada di kota yang sama"@id .

ex:kategoriSerupa a rdf:Property ;
    rdfs:label "kategoriSerupa"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range ex:Toko ;
    rdfs:comment "Toko dengan kategori serupa"@id .

ex:provinsiMemilikiKota a rdf:Property ;
    rdfs:label "provinsiMemilikiKota"@id ;
    rdfs:domain ex:Provinsi ;
    rdfs:range ex:Kota ;
    rdfs:comment "Provinsi memiliki kota"@id .

ex:kotaMemilikiMall a rdf:Property ;
    rdfs:label "kotaMemilikiMall"@id ;
    rdfs:domain ex:Kota ;
    rdfs:range ex:Mall ;
    rdfs:comment "Kota memiliki mall"@id .

# ============================================
# 10 DATA PROPERTIES
# ============================================

ex:namaToko a rdf:Property ;
    rdfs:label "namaToko"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:string ;
    rdfs:comment "Nama toko"@id .

ex:namaMall a rdf:Property ;
    rdfs:label "namaMall"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range xsd:string ;
    rdfs:comment "Nama mall"@id .

ex:kategoriToko a rdf:Property ;
    rdfs:label "kategoriToko"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:string ;
    rdfs:comment "Kategori toko (string)"@id .

ex:lokasiToko a rdf:Property ;
    rdfs:label "lokasiToko"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:string ;
    rdfs:comment "Lokasi toko di mall (lantai & nomor)"@id .

ex:alamatMall a rdf:Property ;
    rdfs:label "alamatMall"@id ;
    rdfs:domain ex:Mall ;
    rdfs:range xsd:string ;
    rdfs:comment "Alamat mall"@id .

ex:namaKota a rdf:Property ;
    rdfs:label "namaKota"@id ;
    rdfs:domain ex:Kota ;
    rdfs:range xsd:string ;
    rdfs:comment "Nama kota"@id .

ex:namaProvinsi a rdf:Property ;
    rdfs:label "namaProvinsi"@id ;
    rdfs:domain ex:Provinsi ;
    rdfs:range xsd:string ;
    rdfs:comment "Nama provinsi"@id .

ex:ratingToko a rdf:Property ;
    rdfs:label "ratingToko"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:float ;
    rdfs:comment "Rating toko (0-5)"@id .

ex:jamBuka a rdf:Property ;
    rdfs:label "jamBuka"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:string ;
    rdfs:comment "Jam buka toko"@id .

ex:nomorTelepon a rdf:Property ;
    rdfs:label "nomorTelepon"@id ;
    rdfs:domain ex:Toko ;
    rdfs:range xsd:string ;
    rdfs:comment "Nomor telepon toko"@id .

# ============================================
# INSTANCE DATA: OPI MALL
# ============================================

# --- Provinsi & Kota ---
res:Provinsi_SumateraSelatan a ex:Provinsi ;
    ex:namaProvinsi "Sumatera Selatan" .

res:Kota_Palembang a ex:Kota ;
    ex:namaKota "Palembang" ;
    ex:beradaDiProvinsi res:Provinsi_SumateraSelatan .

res:Provinsi_SumateraSelatan ex:provinsiMemilikiKota res:Kota_Palembang .

# --- Mall: OPI Mall (Mall65) ---
res:Mall65 a ex:Mall ;
    ex:namaMall "OPI Mall" ;
    ex:alamatMall "Jl. POM IX, Palembang, Sumatera Selatan" ;
    ex:beradaDiKota res:Kota_Palembang ;
    ex:beradaDiProvinsi res:Provinsi_SumateraSelatan .

res:Kota_Palembang ex:kotaMemilikiMall res:Mall65 .

# --- Kategori ---
res:Kategori_FnB a ex:Kategori ;
    ex:namaKategori "F&B" .

res:Kategori_Fashion a ex:Kategori ;
    ex:namaKategori "Fashion" .

res:Kategori_Entertainment a ex:Kategori ;
    ex:namaKategori "Entertainment" .

res:Kategori_Retail a ex:Kategori ;
    ex:namaKategori "Retail" .

res:Kategori_Services a ex:Kategori ;
    ex:namaKategori "Services" .

res:Kategori_Electronics a ex:Kategori ;
    ex:namaKategori "Electronics" .

res:Kategori_HomeLiving a ex:Kategori ;
    ex:namaKategori "Home & Living" .

res:Kategori_BooksToys a ex:Kategori ;
    ex:namaKategori "Books, Toys & Hobbies" .

