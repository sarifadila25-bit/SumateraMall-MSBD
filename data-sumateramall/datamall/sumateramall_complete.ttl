@prefix ex: <http://www.example.org/mall#> .
@prefix ns1: <http://sumateramall.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Kategori a rdfs:Class ;
    rdfs:label "Kategori"@id ;
    rdfs:comment "Kategori toko"@id .

ns1:Kota a rdfs:Class ;
    rdfs:label "Kota"@id ;
    rdfs:comment "Kota lokasi mall"@id .

ns1:Mall a rdfs:Class ;
    rdfs:label "Mall"@id ;
    rdfs:comment "Pusat perbelanjaan"@id .

ns1:Provinsi a rdfs:Class ;
    rdfs:label "Provinsi"@id ;
    rdfs:comment "Provinsi lokasi mall"@id .

ns1:Toko a rdfs:Class ;
    rdfs:label "Toko"@id ;
    rdfs:comment "Toko di dalam mall"@id .

ex:Kategori a rdfs:Class ;
    rdfs:label "Kategori"@id ;
    rdfs:comment "Kategori atau jenis toko"@id .

ex:Kota a rdfs:Class ;
    rdfs:label "Kota"@id ;
    rdfs:comment "Kota lokasi mall"@id .

ex:Mall a rdfs:Class ;
    rdfs:label "Mall"@id ;
    rdfs:comment "Pusat perbelanjaan di Pulau Sumatera"@id .

ex:Provinsi a rdfs:Class ;
    rdfs:label "Provinsi"@id ;
    rdfs:comment "Provinsi di Pulau Sumatera"@id .

ex:Toko a rdfs:Class ;
    rdfs:label "Toko"@id ;
    rdfs:comment "Toko atau tenant di dalam mall"@id .

ns1:alamatMall a rdf:Property ;
    rdfs:label "alamatMall"@id ;
    rdfs:comment "Alamat mall"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range xsd:string .

ns1:beradaDiKota a rdf:Property ;
    rdfs:label "beradaDiKota"@id ;
    rdfs:comment "Mall berada di Kota"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range ns1:Kota .

ns1:beradaDiKotaYangSama a rdf:Property ;
    rdfs:label "beradaDiKotaYangSama"@id ;
    rdfs:comment "Mall berada di kota yang sama"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range ns1:Mall .

ns1:beradaDiLantai a rdf:Property ;
    rdfs:label "beradaDiLantai"@id ;
    rdfs:comment "Toko berada di lantai yang sama dengan toko lain"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range ns1:Toko .

ns1:beradaDiMall a rdf:Property ;
    rdfs:label "beradaDiMall"@id ;
    rdfs:comment "Toko berada di Mall"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range ns1:Mall .

ns1:beradaDiProvinsi a rdf:Property ;
    rdfs:label "beradaDiProvinsi"@id ;
    rdfs:comment "Mall berada di Provinsi"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range ns1:Provinsi .

ns1:jamBuka a rdf:Property ;
    rdfs:label "jamBuka"@id ;
    rdfs:comment "Jam buka toko"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:string .

ns1:kategoriSerupa a rdf:Property ;
    rdfs:label "kategoriSerupa"@id ;
    rdfs:comment "Toko dengan kategori serupa"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range ns1:Toko .

ns1:kategoriToko a rdf:Property ;
    rdfs:label "kategoriToko"@id ;
    rdfs:comment "Kategori toko (string)"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:string .

ns1:kotaMemilikiMall a rdf:Property ;
    rdfs:label "kotaMemilikiMall"@id ;
    rdfs:comment "Kota memiliki mall"@id ;
    rdfs:domain ns1:Kota ;
    rdfs:range ns1:Mall .

ns1:lokasiToko a rdf:Property ;
    rdfs:label "lokasiToko"@id ;
    rdfs:comment "Lokasi toko di mall (lantai & nomor)"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:string .

ns1:memilikiKategori a rdf:Property ;
    rdfs:label "memilikiKategori"@id ;
    rdfs:comment "Toko memiliki kategori"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range ns1:Kategori .

ns1:memilikiToko a rdf:Property ;
    rdfs:label "memilikiToko"@id ;
    rdfs:comment "Mall memiliki toko"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range ns1:Toko .

ns1:namaKota a rdf:Property ;
    rdfs:label "namaKota"@id ;
    rdfs:comment "Nama kota"@id ;
    rdfs:domain ns1:Kota ;
    rdfs:range xsd:string .

ns1:namaMall a rdf:Property ;
    rdfs:label "namaMall"@id ;
    rdfs:comment "Nama mall"@id ;
    rdfs:domain ns1:Mall ;
    rdfs:range xsd:string .

ns1:namaProvinsi a rdf:Property ;
    rdfs:label "namaProvinsi"@id ;
    rdfs:comment "Nama provinsi"@id ;
    rdfs:domain ns1:Provinsi ;
    rdfs:range xsd:string .

ns1:namaToko a rdf:Property ;
    rdfs:label "namaToko"@id ;
    rdfs:comment "Nama toko"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:string .

ns1:nomorTelepon a rdf:Property ;
    rdfs:label "nomorTelepon"@id ;
    rdfs:comment "Nomor telepon toko"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:string .

ns1:provinsiMemilikiKota a rdf:Property ;
    rdfs:label "provinsiMemilikiKota"@id ;
    rdfs:comment "Provinsi memiliki kota"@id ;
    rdfs:domain ns1:Provinsi ;
    rdfs:range ns1:Kota .

ns1:ratingToko a rdf:Property ;
    rdfs:label "ratingToko"@id ;
    rdfs:comment "Rating toko (0-5)"@id ;
    rdfs:domain ns1:Toko ;
    rdfs:range xsd:float .

