@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb#> .

[] rdf:type fuseki:Server ;
   fuseki:services (<#sumateramall>) .

<#sumateramall> rdf:type fuseki:Service ;
    rdfs:label "SumateraMall Clean Recovery" ;
    fuseki:name "sumateramall" ;
    fuseki:dataset <#dataset> ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:name "query" ;
                      fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:name "update" ;
                      fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:name "data" ;
                      fuseki:operation fuseki:gsp-rw ] ;
    .

<#dataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "D:/sem3/sumateramall-MSBD/fuseki/recovery/sumateramall-clean" ;
    .


